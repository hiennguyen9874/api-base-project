# Copy to .env for local development. Never use these values in production.
COMPOSE_PROJECT_NAME=cashlens
IMAGE_TAG=local

APP__NAME=CashLens
APP__VERSION=0.1.0
APP__TIMEZONE=Asia/Ho_Chi_Minh
APP__PORT=11111
APP__API_PORT=11112
APP__CORS_ORIGINS=http://localhost:5173,http://localhost:11111
APP__TRUSTED_HOST=localhost,127.0.0.1,api
APP__ENABLE_DOCS=true
APP__SECRET_KEY=local-only-app-secret-change-before-deployment

API__CONCURRENCY=1

TOKEN__ACCESS_TOKEN_SECRET_KEY=local-only-access-token-secret-change-me
TOKEN__REFRESH_TOKEN_SECRET_KEY=local-only-refresh-token-secret-change-me
TOKEN__COOKIE_SECURE=false
TOKEN__COOKIE_SAMESITE=lax

POSTGRES__USER=cashlens
POSTGRES__PASSWORD=local-only-postgres-password
POSTGRES__DB=cashlens

RABBITMQ__USER=cashlens
RABBITMQ__PASS=local-only-rabbitmq-password
TASKIQ__BROKER_URL=amqp://cashlens:local-only-rabbitmq-password@rabbitmq:5672
TASKIQ__RESULT_BACKEND=redis://redis-cache:6379/0

USER__OPEN_REGISTRATION=false
USER__FIRST_USER_EMAIL=owner@example.com
USER__FIRST_USER_PASSWORD=local-only-owner-password
USER__FIRST_USER_FULL_NAME=CashLens Owner

SENTRY__DSN=null
SENTRY__ENVIRONMENT=development

FRONTEND_DEV_PORT=5173
VITE_ENABLE_MSW=false

PGADMIN__EMAIL=admin@localhost.test
PGADMIN__PASSWORD=local-only-pgadmin-password
PGADMIN__PORT=5050
REDISINSIGHT__PORT=5540
