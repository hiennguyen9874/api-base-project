# Copy outside source control or inject these values from your secret manager.
COMPOSE_PROJECT_NAME=cashlens
IMAGE_TAG=v0.1.0
API_IMAGE=ghcr.io/hiennguyen9874/cashlens/api
WEB_IMAGE=ghcr.io/hiennguyen9874/cashlens/web

APP__NAME=CashLens
APP__VERSION=0.1.0
APP__TIMEZONE=UTC
APP__PORT=80
APP__TRUSTED_HOST=cashlens.example.com
APP__CORS_ORIGINS=https://cashlens.example.com
APP__SECRET_KEY=CHANGE_ME_TO_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
PRODUCTION_ENABLE_DOCS=false
API__CONCURRENCY=2

TOKEN__ACCESS_TOKEN_SECRET_KEY=CHANGE_ME_TO_A_DIFFERENT_RANDOM_32_CHAR_VALUE
TOKEN__REFRESH_TOKEN_SECRET_KEY=CHANGE_ME_TO_ANOTHER_RANDOM_32_CHAR_VALUE

POSTGRES__USER=cashlens
POSTGRES__PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES__DB=cashlens

RABBITMQ__USER=cashlens
RABBITMQ__PASS=CHANGE_ME_RABBITMQ_PASSWORD
TASKIQ__BROKER_URL=amqp://cashlens:CHANGE_ME_RABBITMQ_PASSWORD@rabbitmq:5672
TASKIQ__RESULT_BACKEND=redis://redis-cache:6379/0

USER__OPEN_REGISTRATION=false
USER__FIRST_USER_EMAIL=owner@example.com
USER__FIRST_USER_PASSWORD=CHANGE_ME_INITIAL_OWNER_PASSWORD
USER__FIRST_USER_FULL_NAME=CashLens Owner

SENTRY__DSN=null
SENTRY__ENVIRONMENT=production
